# Whisper Typer Configuration Example
# Copy this file to .env and modify as needed

# ── Model Settings ────────────────────────────────────────────────────────────
# Default model to load on startup (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small

# Custom path to store downloaded models (optional)
# Default: ~/.whisper-typer/models
# WHISPER_MODELS_DIR=D:/AI/whisper-models

# ── API Settings ──────────────────────────────────────────────────────────────
# Hugging Face token for private models or faster downloads (optional)
HF_TOKEN=

# ── Server Settings ───────────────────────────────────────────────────────────
# Note: Changing these may require updates in core/config.py
# SERVER_IP=127.0.0.1
# SERVER_PORT=8000
